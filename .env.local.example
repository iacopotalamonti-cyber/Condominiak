# Condominiak — variabili d'ambiente.
#
#   cp .env.local.example .env.local
#
# Le stesse vanno impostate su Netlify in Site settings → Environment variables.
# .env.local è ignorato da git: le chiavi vere non entrano mai nel repository.

# ---------------------------------------------------------------------------
# Supabase — Project settings → API
# ---------------------------------------------------------------------------

# URL del progetto, es. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblica (anon). Arriva al browser: è protetta dalle policy RLS,
# non dal segreto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role: scavalca ogni policy RLS. Solo server-side — route API e
# Netlify Function. Se finisce in una variabile NEXT_PUBLIC_* o in un componente
# client, chiunque può leggere e scrivere l'intero database.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anthropic — estrazione dei dati dai documenti
# ---------------------------------------------------------------------------

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Opzionali: cambiano la leva costo/qualità senza un rilascio.
# Default nel codice: claude-opus-5 con effort "high" (src/lib/anthropic.ts).
# EXTRACTION_MODEL=claude-sonnet-5
# EXTRACTION_EFFORT=medium        # low | medium | high | xhigh | max

# Lasciare vuoto. Serve solo per tornare all'AI Gateway di Netlify, che fattura
# l'inferenza sui crediti dell'hosting: è già costato un sito offline.
# Vedi docs/DECISIONI.md.
# ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# Applicazione
# ---------------------------------------------------------------------------

# Base degli URL negli inviti via email. In locale http://localhost:3000,
# in produzione il dominio vero. Se è sbagliato, gli inviti puntano altrove.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=Condominiak

# ---------------------------------------------------------------------------
# Sentry — tracciamento degli errori
# ---------------------------------------------------------------------------

# Lasciarlo vuoto in locale: senza DSN l'applicazione gira identica, senza
# inviare nulla. Il valore si trova in Sentry → Settings → Projects →
# Client Keys (DSN). Finisce nel browser: non è un segreto, ma è tuo.
NEXT_PUBLIC_SENTRY_DSN=

# Etichetta l'ambiente negli errori del browser ("production", "staging").
# Lato server la ricava da CONTEXT, che imposta Netlify da sé.
NEXT_PUBLIC_SENTRY_ENV=development
